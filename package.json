{
  "name": "jeopardy",
  "version": "1.0.0",
  "private": true,
  "description": "Fully customizable Jeopardy game with phone buzzers over your local network",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "build": "vite build",
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts --dev\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "express": "^5.3.0",
    "motion": "^14.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
